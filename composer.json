{
    "name": "maristas/ui-kit",
    "description": "Sistema de diseño de los sistemas Maristas: tokens, estilos sobre Bootstrap 5 y componentes Blade.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.0.2",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": { "Maristas\\UiKit\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Maristas\\UiKit\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Maristas\\UiKit\\UiKitServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": { "allow-plugins": { "composer/package-versions-deprecated": true } }
}
